{
  "name": "boggle-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "next build",
    "start": "cross-env NODE_ENV=production tsx server.ts",
    "lint": "next lint",
    "test": "vitest",
    "test:run": "vitest run",
    "test:server": "vitest --project server",
    "test:client": "vitest --project client",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts"
  },
  "dependencies": {
    "next": "15.4.4",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "socket.io": "4.8.1",
    "socket.io-client": "4.8.1",
    "zustand": "5.0.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "4.1.11",
    "@types/node": "20",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "cross-env": "^10.1.0",
    "eslint": "9.32.0",
    "eslint-config-next": "15.4.4",
    "jsdom": "^29.0.0",
    "tailwindcss": "4.1.11",
    "tsx": "^4.21.0",
    "typescript": "5.8.3",
    "vitest": "^4.1.0"
  }
}
